From 1067b1475522771ae19364445982fed516e12545 Mon Sep 17 00:00:00 2001
From: Pedro Harada <pedroyujiharada@gmail.com>
Date: Fri, 18 Sep 2026 19:31:38 -0300
Subject: [PATCH 3/4] Add a simulated Livox Mid-360 for FAST_LIO

The LIMO only had a 2D LaserScan, which is what the Nav2 costmaps use
but is not enough for FAST_LIO, which consumes a 3D point cloud. Add the
ros2_livox_simulation Gazebo Classic plugin (Mid-360 scan pattern) to the
ackermann model, mounted on top of the chassis and publishing CustomMsg
on /livox/lidar (and PointCloud2 on /livox/lidar_PointCloud2).

The sensor is declared in sensor.xacro rather than by including the
package mid360.xacro, for two reasons: always_on is required for the
topic to publish in a headless server (without it Gazebo only updates
the sensor when there is a transport subscriber), and naming the link
after the sensor keeps the message frame_id ("livox") aligned with TF.

The 2D laser is left untouched: Nav2 keeps using /scan for obstacles and
FAST_LIO only supplies the world frame and odometry.

The plugin is a clone from setup.sh, so it is declared as an exec
dependency instead of being vendored here.
---
 limo_car/gazebo/ackermann_with_sensor.xacro | 15 ++++
 limo_car/gazebo/sensor.xacro                | 76 +++++++++++++++++++++
 limo_car/package.xml                        |  4 ++
 3 files changed, 95 insertions(+)

diff --git a/limo_car/gazebo/ackermann_with_sensor.xacro b/limo_car/gazebo/ackermann_with_sensor.xacro
index 4173148..c3adb02 100644
--- a/limo_car/gazebo/ackermann_with_sensor.xacro
+++ b/limo_car/gazebo/ackermann_with_sensor.xacro
@@ -24,6 +24,21 @@ andere Sensoren zusammengebaut werden und laden sie das Modell in Gazebo.-->
         <parent link="base_link"/>
         <child link="laser_link"/>
     </joint>
+
+    <!-- ******************* Livox Mid-360 (3D) *********************** -->
+    <!-- Nuvem 3D para o FAST_LIO. O laser 2D acima continua sendo a fonte
+         de obstáculos dos costmaps do Nav2; este sensor só acrescenta a
+         geometria 3D que o FAST_LIO consome (CustomMsg em /livox/lidar).
+         O macro vive em sensor.xacro; o plugin e o CSV do padrão de
+         varredura vêm do ros2_livox_simulation (clonado pelo setup.sh). -->
+    <xacro:gazebo_livox frame_prefix="livox" />
+
+    <joint name="livox_joint" type="fixed">
+        <origin xyz="0 0 0.06" rpy="0 0 0"/>
+        <parent link="base_link"/>
+        <child link="livox"/>
+    </joint>
+
     <!-- ************************* Depth-camera *********************** -->
     <xacro:gazebo_depth_camera frame_prefix="depth_camera" />
 
diff --git a/limo_car/gazebo/sensor.xacro b/limo_car/gazebo/sensor.xacro
index 32ddfa0..664992b 100644
--- a/limo_car/gazebo/sensor.xacro
+++ b/limo_car/gazebo/sensor.xacro
@@ -81,6 +81,82 @@ realisierbar elektrische Komponente, also Sensoren aus Gazebo-Package. Diese Ant
         </gazebo>
     </xacro:macro>
 
+    <!-- ******************** Makrofunktion für Livox Mid-360 ******************** -->
+    <!-- Nuvem 3D (livox_ros_driver2/CustomMsg + sensor_msgs/PointCloud2) para o
+         FAST_LIO. O plugin (libros2_livox.so) e o CSV do padrao de varredura
+         vem do pacote ros2_livox_simulation, clonado pelo setup.sh.
+         O sensor e declarado aqui, e nao via mid360.xacro do pacote externo,
+         por dois motivos:
+           1. always_on: sem ele o Gazebo so atualiza o sensor quando existe
+              assinante de transporte, e headless o topico nunca publica;
+           2. o nome do link e igual ao nome do sensor, para o frame_id das
+              mensagens ("livox") bater com o frame da TF. -->
+    <xacro:macro name="gazebo_livox" params="frame_prefix">
+        <link name='${frame_prefix}'>
+            <inertial>
+                <mass value="0.4"/>
+                <origin xyz="0 0 0" rpy="0 0 0"/>
+                <inertia ixx="1e-4" ixy="0" ixz="0"
+                         iyy="1e-4" iyz="0"
+                         izz="1e-4"/>
+            </inertial>
+            <visual name='livox_visual'>
+                <origin xyz="0 0 0" rpy="0 0 0"/>
+                <geometry>
+                    <box size="0.1 0.06 0.06"/>
+                </geometry>
+            </visual>
+            <collision name='livox_collision'>
+                <origin xyz="0 0 0" rpy="0 0 0"/>
+                <geometry>
+                    <box size="0.1 0.06 0.06"/>
+                </geometry>
+            </collision>
+        </link>
+
+        <gazebo reference="${frame_prefix}">
+            <sensor type="ray" name="${frame_prefix}">
+                <pose>0 0 0 0 0 0</pose>
+                <always_on>true</always_on>
+                <visualize>true</visualize>
+                <update_rate>10</update_rate>
+                <plugin name="${frame_prefix}_plugin" filename="libros2_livox.so">
+                    <ray>
+                        <scan>
+                            <horizontal>
+                                <samples>100</samples>
+                                <resolution>1</resolution>
+                                <min_angle>0</min_angle>
+                                <max_angle>6.28318</max_angle>
+                            </horizontal>
+                            <vertical>
+                                <samples>360</samples>
+                                <resolution>1</resolution>
+                                <min_angle>-0.126</min_angle>
+                                <max_angle>0.964</max_angle>
+                            </vertical>
+                        </scan>
+                        <range>
+                            <min>0.1</min>
+                            <max>200.0</max>
+                            <resolution>0.002</resolution>
+                        </range>
+                        <noise>
+                            <type>gaussian</type>
+                            <mean>0.0</mean>
+                            <stddev>0.01</stddev>
+                        </noise>
+                    </ray>
+                    <visualize>false</visualize>
+                    <samples>40000</samples>
+                    <downsample>1</downsample>
+                    <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>
+                    <topic>livox/lidar</topic>
+                </plugin>
+            </sensor>
+        </gazebo>
+    </xacro:macro>
+
     <!-- ******************************* Makrofunktion für Depth-Camera ***************************** -->
     <xacro:macro name="gazebo_depth_camera" params="frame_prefix">
         <link name='${frame_prefix}_link'>
