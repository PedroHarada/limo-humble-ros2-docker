From 0f49cd10637539f14c74788cb62abc95e86125a8 Mon Sep 17 00:00:00 2001
From: Pedro Harada <pedroyujiharada@gmail.com>
Date: Fri, 18 Sep 2026 21:50:41 -0300
Subject: [PATCH 4/4] Fix the LIMO model rendering in RViz and Gazebo

Three defects kept the ackermann model from showing up correctly:

- The mesh filenames were "$(find limo_car)/meshes/..." without the
  file:// scheme, unlike limo_description. RViz failed to load both
  limo_base.dae and limo_wheel.dae with "Unable to open file", so the
  RobotModel display came up empty (the model looked incomplete). Add
  the scheme, which both RViz and Gazebo understand.
- The ackermann model declared the ROS 1 plugin libgazebo_ros_control.so,
  which does not exist on Humble; Gazebo logged "Failed to load plugin"
  on every spawn. The ackermann_drive plugin already handles control.
- The base_link carried a <color rgba="0 0 0 0.5"/> override that could
  render the chassis translucent. Removed so the mesh uses its own
  limo_base.dae materials.
---
 limo_car/gazebo/ackermann.xacro | 21 ++++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/limo_car/gazebo/ackermann.xacro b/limo_car/gazebo/ackermann.xacro
index e68f3c2..2f668ec 100644
--- a/limo_car/gazebo/ackermann.xacro
+++ b/limo_car/gazebo/ackermann.xacro
@@ -106,7 +106,7 @@ Es würde einfach in andere Datei angerufen werden. -->
             <visual>
                 <origin xyz="0 0 0" rpy="0 0 0" />
                 <geometry>
-                    <mesh filename="$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
+                    <mesh filename="file://$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
                 </geometry>
             </visual>
             <collision>
@@ -184,7 +184,7 @@ Es würde einfach in andere Datei angerufen werden. -->
             <visual>
                 <origin xyz="0 0 0" rpy="0 0 0" />
                 <geometry>
-                    <mesh filename="$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2" />
+                    <mesh filename="file://$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2" />
                 </geometry>
             </visual>
             <collision>
@@ -242,7 +242,7 @@ Es würde einfach in andere Datei angerufen werden. -->
                 <origin xyz="0 0 -0.15" rpy="0 0 ${M_PI/2}" />
                 <geometry>
                     <!-- Modell von Hersteller, aber es ist kleiner als realen Produkt, da die Skale vergrößert wird -->
-                    <mesh filename="$(find limo_car)/meshes/limo_base.dae" scale="1.2 1.2 1.2" />
+                    <mesh filename="file://$(find limo_car)/meshes/limo_base.dae" scale="1.2 1.2 1.2" />
                 </geometry>
             </visual>
             <!-- Modell für physikalische Kollision zu modellieren. -->
@@ -256,9 +256,10 @@ Es würde einfach in andere Datei angerufen werden. -->
         </link>
 
         <gazebo reference="base_link">
-            <material>
-                <color rgba="0 0 0 0.5"/>
-            </material>
+            <!-- Sem override de material: a carcaça usa os materiais do proprio
+                 limo_base.dae. O <color rgba="0 0 0 0.5"/> que havia aqui
+                 deixava o corpo 50% transparente, e dava a impressao de modelo
+                 furado/incompleto. -->
         </gazebo>
 
         <!-- hinten Räder -->
@@ -266,7 +267,7 @@ Es würde einfach in andere Datei angerufen werden. -->
             <visual>
                 <origin xyz="0 0 0" rpy="0 0 0" />
                 <geometry>
-                    <mesh filename="$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
+                    <mesh filename="file://$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
                 </geometry>
             </visual>
             <collision>
@@ -300,7 +301,7 @@ Es würde einfach in andere Datei angerufen werden. -->
             <visual>
                 <origin xyz="0 0 0" rpy="0 0 0" />
                 <geometry>
-                    <mesh filename="$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
+                    <mesh filename="file://$(find limo_car)/meshes/limo_wheel.dae" scale="1.2 1.2 1.2"/>
                 </geometry>
             </visual>
             <collision>
@@ -342,7 +343,9 @@ Es würde einfach in andere Datei angerufen werden. -->
         <!-- ********************************** Kontrolle zu erstellen ************************************* -->
         <!-- *********************************************************************************************** -->
         <gazebo>
-            <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so" />
+            <!-- libgazebo_ros_control.so nao existe no ROS 2 (era o plugin de
+                 ROS 1); o Gazebo logava "Failed to load plugin". Quem controla
+                 o robo aqui e o ackermann_drive abaixo. -->
             <plugin name="ackermann_controller" filename="libgazebo_ros_ackermann_drive.so">
                 <update_rate>100</update_rate>
                 <front_left_joint>front_left_wheel_joint</front_left_joint>
